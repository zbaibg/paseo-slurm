+  public async closeOpenedTabs(): Promise<void> {
+    for (const browserId of this.openedTabs) {
+      await this.execute({ command: "close_tab", args: { browserId } }).catch(() => undefined);
+    }
+    this.openedTabs.clear();
+  }
