+
+// The download allowlist and size cap are read from config.json on every call, so editing
+// daemon.browserTools.download takes effect without restarting the daemon.
+function readBrowserDownloadToolSettings(options: PaseoToolHostDependencies) {
+  const enabled = options.daemonConfigStore?.get().browserTools?.enabled ?? true;
+  if (!options.paseoHome) {
+    return readBrowserDownloadSettings({ enabled, downloadConfig: undefined });
+  }
+  try {
+    const persisted = loadPersistedConfig(options.paseoHome);
+    return readBrowserDownloadSettings({
+      enabled,
+      downloadConfig: persisted.daemon?.browserTools?.download,
+    });
+  } catch (error) {
+    return {
+      ...readBrowserDownloadSettings({ enabled, downloadConfig: undefined }),
+      configError: error instanceof Error ? error.message : String(error),
+    };
+  }
+}
diff --git a/packages/server/src/server/browser-tools/download.test.ts b/packages/server/src/server/browser-tools/download.test.ts
new file mode 100644
index 000000000..fa5a8a264
--- /dev/null
+++ b/packages/server/src/server/browser-tools/download.test.ts
@@ -0,0 +1,671 @@
+import { createHash } from "node:crypto";
+import { mkdtemp, mkdir, readFile, readdir, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, test } from "vitest";
+import { z } from "zod";
+import type { BrowserToolsBroker, BrowserToolsExecuteInput } from "./broker.js";
+import type { BrowserToolsResponsePayload } from "./errors.js";
+import {
+  BROWSER_DOWNLOAD_CHUNK_BYTES,
+  readBrowserDownloadSettings,
+  registerBrowserDownloadTool,
+  type BrowserDownloadSettings,
+} from "./download.js";
+import type {
+  PaseoToolConfig,
+  PaseoToolExecutionContext,
+  PaseoToolResult,
+} from "../agent/tools/types.js";
+
+const ARTICLE_TAB = "11111111-1111-4111-8111-111111111111";
+const NEW_TAB = "22222222-2222-4222-8222-222222222222";
+const ARTICLE_URL = "https://publisher.example/doi/10.1000/xyz";
+const PDF_URL = "https://publisher.example/doi/pdf/10.1000/xyz";
+const CDN_LINK = "https://publisher.example/article-pdf/xyz.pdf";
+const CDN_URL = "https://cdn.example/signed/xyz.pdf?Expires=1";
+// Mirrors packages/desktop/src/features/browser-automation/service.ts.
+const DESKTOP_MAX_RESULT_JSON = 80_000;
+const DESKTOP_PREVIEW = 79_000;
+
+interface FakeResource {
+  status?: number;
+  body: Uint8Array;
+  contentType?: string;
+  // Where a redirect ends; fetch reports it as response.url and navigation lands there.
+  finalUrl?: string;
+}
+
+interface FakePage {
+  href: string;
+  window: Record<string, unknown>;
+  readyState?: string;
+}
+
+// How a new tab registers with the desktop automation host. The real app waits 5 s, then
+// answers browser_timeout naming the tab, which stays open and may register later.
+type FakeRegistration = "immediate" | "never" | { afterListCalls: number };
+
+class FakeDownloadBroker {
+  public readonly calls: BrowserToolsExecuteInput[] = [];
+  public readonly resultJsonLengths: number[] = [];
+  public readonly fetchedUrls: string[] = [];
+  public readonly pages = new Map<string, FakePage>();
+  public hostConnected = true;
+  public pageHasSubtleCrypto = true;
+  public onChunkResult: ((resultJson: string, chunkIndex: number) => string) | null = null;
+  public beforeChunk: ((page: FakePage, chunkIndex: number) => void) | null = null;
+  public beforeStatus: ((page: FakePage) => void) | null = null;
+  public newTabRegistration: FakeRegistration = "immediate";
+  public timeoutMessageNamesTab = true;
+  public newTabReadyState = "complete";
+  public readonly closedTabs: string[] = [];
+  private readonly registered = new Set<string>([ARTICLE_TAB]);
+  private listCallsSinceNewTab = 0;
+  private chunkReads = 0;
+
+  public constructor(private readonly resources: Map<string, FakeResource>) {
+    this.pages.set(ARTICLE_TAB, { href: ARTICLE_URL, window: {} });
+  }
+
+  public async execute(input: BrowserToolsExecuteInput): Promise<BrowserToolsResponsePayload> {
+    this.calls.push(input);
+    const requestId = `req-${this.calls.length}`;
+    if (!this.hostConnected) {
+      return fail(requestId, "browser_no_host", "No browser automation host is connected.", true);
+    }
+    const command = input.command;
+    if (command.command === "new_tab") {
+      return this.newTab(requestId, command.args.url);
+    }
+    if (command.command === "list_tabs") {
+      return this.listTabs(requestId);
+    }
+    if (command.command === "close_tab") {
+      return this.closeTab(requestId, command.args.browserId);
+    }
+    const page = this.registered.has(command.args.browserId)
+      ? this.pages.get(command.args.browserId)
+      : undefined;
+    if (!page) {
+      return fail(requestId, "browser_tab_not_found", `No browser tab ${command.args.browserId}`);
+    }
+    if (command.command === "navigate") {
+      page.href = this.resources.get(command.args.url)?.finalUrl ?? command.args.url;
+      page.window = {};
+      return {
+        requestId,
+        ok: true,
+        result: { command: "navigate", browserId: command.args.browserId, url: command.args.url },
+      };
+    }
+    if (command.command !== "evaluate") {
+      return fail(requestId, "browser_unsupported", `unexpected ${command.command}`);
+    }
+    const isChunk = command.args.function.includes("btoa(");
+    const chunkIndex = isChunk ? this.chunkReads++ : -1;
+    if (isChunk) {
+      this.beforeChunk?.(page, chunkIndex);
+    }
+    if (command.args.function.includes('return { state: "missing" }')) {
+      this.beforeStatus?.(page);
+    }
+    const value = await this.runInPage(page, command.args.function);
+    let resultJson = JSON.stringify(value) ?? "null";
+    if (isChunk && this.onChunkResult) {
+      resultJson = this.onChunkResult(resultJson, chunkIndex);
+    }
+    this.resultJsonLengths.push(resultJson.length);
+    const truncated = resultJson.length > DESKTOP_MAX_RESULT_JSON;
+    return {
+      requestId,
+      ok: true,
+      result: {
+        command: "evaluate",
+        browserId: command.args.browserId,
+        resultJson: truncated ? JSON.stringify(resultJson.slice(0, DESKTOP_PREVIEW)) : resultJson,
+        truncated,
+      },
+    };
+  }
+
+  private newTab(requestId: string, target: string | undefined): BrowserToolsResponsePayload {
+    const url = target ?? "https://example.com";
+    const href = this.resources.get(url)?.finalUrl ?? url;
+    this.pages.set(NEW_TAB, { href, window: {}, readyState: this.newTabReadyState });
+    this.listCallsSinceNewTab = 0;
+    if (this.newTabRegistration === "immediate") {
+      this.registered.add(NEW_TAB);
+      return {
+        requestId,
+        ok: true,
+        result: { command: "new_tab", browserId: NEW_TAB, workspaceId: "wks_a", url },
+      };
+    }
+    const named = this.timeoutMessageNamesTab ? `browser tab ${NEW_TAB}` : "the new browser tab";
+    return fail(
+      requestId,
+      "browser_timeout",
+      `Timed out waiting for ${named} to register with the browser automation host. Try browser_new_tab again.`,
+      true,
+    );
+  }
+
+  private listTabs(requestId: string): BrowserToolsResponsePayload {
+    this.listCallsSinceNewTab += 1;
+    const registration = this.newTabRegistration;
+    if (
+      this.pages.has(NEW_TAB) &&
+      typeof registration === "object" &&
+      this.listCallsSinceNewTab >= registration.afterListCalls
+    ) {
+      this.registered.add(NEW_TAB);
+    }
+    const tabs = [...this.registered]
+      .filter((id) => this.pages.has(id))
+      .map((id) => ({
+        browserId: id,
+        url: this.pages.get(id)!.href,
+        title: "",
+        isActive: false,
+        isLoading: false,
+      }));
+    return { requestId, ok: true, result: { command: "list_tabs", tabs } };
+  }
+
+  // The app closes a tab from its own stores, registered with the host or not.
+  private closeTab(requestId: string, browserId: string): BrowserToolsResponsePayload {
+    this.closedTabs.push(browserId);
+    this.pages.delete(browserId);
+    this.registered.delete(browserId);
+    return { requestId, ok: true, result: { command: "close_tab", browserId } };
+  }
+
+  public chunkReadCount(): number {
+    return this.chunkReads;
+  }
+
+  private runInPage(page: FakePage, source: string): Promise<unknown> {
+    const fakeFetch = async (url: string, init: RequestInit): Promise<Response> => {
+      this.fetchedUrls.push(url);
+      expect(init.credentials).toBe("include");
+      const resource = this.resources.get(url);
+      const finalUrl = resource?.finalUrl ?? url;
+      // Same-origin policy without CORS headers: only the page's own origin can be read.
+      if (!resource || new URL(finalUrl).origin !== new URL(page.href).origin) {
+        throw new TypeError("Failed to fetch");
+      }
+      const response = new Response(resource.body, {
+        status: resource.status ?? 200,
+        headers: {
+          "content-type": resource.contentType ?? "application/pdf",
+          "content-length": String(resource.body.byteLength),
+        },
+      });
+      Object.defineProperty(response, "url", { value: finalUrl });
+      return response;
+    };
+    const pageCrypto = this.pageHasSubtleCrypto ? globalThis.crypto : {};
+    const pageGlobal = { crypto: pageCrypto };
+    const build = new Function(
+      "window",
+      "location",
+      "fetch",
+      "crypto",
+      "globalThis",
+      "document",
+      `return (${source});`,
+    ) as (...args: unknown[]) => () => unknown;
+    const document = { readyState: page.readyState ?? "complete" };
+    const fn = build(page.window, { href: page.href }, fakeFetch, pageCrypto, pageGlobal, document);
+    return Promise.resolve(fn());
+  }
+}
+
+interface RegisteredTool {
+  config: PaseoToolConfig;
+  handler: (args: unknown, context: PaseoToolExecutionContext) => Promise<PaseoToolResult>;
+}
+
+class DownloadHarness {
+  public readonly broker: FakeDownloadBroker;
+  public settings: BrowserDownloadSettings;
+  private readonly tool: RegisteredTool;
+
+  public constructor(params: {
+    cwd: string;
+    resources: Map<string, FakeResource>;
+    chunkBytes?: number;
+    workspaceId?: string;
+    tabRegistrationWaitMs?: number;
+  }) {
+    this.broker = new FakeDownloadBroker(params.resources);
+    this.settings = { enabled: true, allowedRoots: null, maxBytes: 200 * 1024 * 1024 };
+    let registered: RegisteredTool | null = null;
+    registerBrowserDownloadTool({
+      registerTool: (name, config, handler) => {
+        expect(name).toBe("browser_download");
+        registered = { config, handler };
+      },
+      broker: this.broker as Pick<BrowserToolsBroker, "execute">,
+      callerAgentId: "agent-1",
+      resolveCallerAgent: () => ({
+        id: "agent-1",
+        cwd: params.cwd,
+        workspaceId: params.workspaceId ?? "wks_a",
+      }),
+      readSettings: () => this.settings,
+      pollIntervalMs: 1,
+      tabRegistrationWaitMs: params.tabRegistrationWaitMs ?? 200,
+      ...(params.chunkBytes ? { chunkBytes: params.chunkBytes } : {}),
+    });
+    if (!registered) {
+      throw new Error("browser_download was not registered");
+    }
+    this.tool = registered;
+  }
+
+  public validate(input: unknown) {
+    return (this.tool.config.inputSchema as z.ZodType).safeParse(input);
+  }
+
+  public async run(input: unknown): Promise<{ text: string; structured: Record<string, unknown> }> {
+    const parsed = (this.tool.config.inputSchema as z.ZodType).parse(input);
+    const result = await this.tool.handler(parsed, {});
+    return {
+      text: result.content.map((item) => item.text ?? "").join("\n"),
+      structured: result.structuredContent as Record<string, unknown>,
+    };
+  }
+}
+
+function fail(
+  requestId: string,
+  code: Extract<BrowserToolsResponsePayload, { ok: false }>["error"]["code"],
+  message: string,
+  retryable = false,
+): BrowserToolsResponsePayload {
+  return { requestId, ok: false, error: { code, message, retryable } };
+}
+
+function pdfBytes(size: number): Uint8Array {
+  const bytes = new Uint8Array(size);
+  let state = 12345;
+  for (let i = 0; i < size; i += 1) {
+    state = (state * 1103515245 + 12345) >>> 0;
+    bytes[i] = state >>> 24;
+  }
+  bytes.set(Buffer.from("%PDF-1.7\n", "latin1"), 0);
+  return bytes;
+}
+
+function sha256(bytes: Uint8Array): string {
+  return createHash("sha256").update(bytes).digest("hex");
+}
+
+function errorCode(structured: Record<string, unknown>): string | undefined {
+  return (structured.error as { code?: string } | undefined)?.code;
+}
+
+describe("browser_download", () => {
+  let cwd: string;
+  let outside: string;
+  // Two full chunks plus a partial one, so reassembly order and the short tail are exercised.
+  const pdf = pdfBytes(2 * BROWSER_DOWNLOAD_CHUNK_BYTES + 1_234);
+
+  beforeEach(async () => {
+    cwd = await mkdtemp(join(tmpdir(), "paseo-browser-download-cwd-"));
+    outside = await mkdtemp(join(tmpdir(), "paseo-browser-download-outside-"));
+  });
+
+  afterEach(async () => {
+    await rm(cwd, { recursive: true, force: true });
+    await rm(outside, { recursive: true, force: true });
+  });
+
+  function harness(extra: Partial<ConstructorParameters<typeof DownloadHarness>[0]> = {}) {
+    return new DownloadHarness({
+      cwd,
+      resources: new Map<string, FakeResource>([
+        [PDF_URL, { body: pdf }],
+        [CDN_LINK, { body: pdf, finalUrl: CDN_URL }],
+        [CDN_URL, { body: pdf }],
+        [
+          ARTICLE_URL,
+          { body: Buffer.from("<!DOCTYPE html><html>article</html>"), contentType: "text/html" },
+        ],
+        ["https://publisher.example/missing.pdf", { status: 404, body: Buffer.from("not found") }],
+      ]),
+      ...extra,
+    });
+  }
+
+  test("reassembles a multi-chunk file byte-exactly and returns only a summary", async () => {
+    const h = harness();
+
+    const { text, structured } = await h.run({
+      url: PDF_URL,
+      browserId: ARTICLE_TAB,
+      path: "references/paper.pdf",
+      expectMagic: "%PDF-",
+    });
+
+    const written = await readFile(join(cwd, "references/paper.pdf"));
+    expect(written.equals(Buffer.from(pdf))).toBe(true);
+    expect(structured).toMatchObject({
+      ok: true,
+      path: join(cwd, "references/paper.pdf"),
+      bytes: pdf.byteLength,
+      sha256: sha256(pdf),
+      hashVerified: true,
+      contentType: "application/pdf",
+      finalUrl: PDF_URL,
+      httpStatus: 200,
+      magic: { expected: "%PDF-", matched: true },
+      chunks: 3,
+    });
+    expect(text.length).toBeLessThan(1_000);
+    expect(h.broker.chunkReadCount()).toBe(3);
+    expect(Math.max(...h.broker.resultJsonLengths)).toBeLessThanOrEqual(DESKTOP_MAX_RESULT_JSON);
+    // The page buffer is freed and no temporary file is left behind.
+    const pageStore = h.broker.pages.get(ARTICLE_TAB)?.window.__paseoBrowserDownloads;
+    expect(pageStore).toBeInstanceOf(Map);
+    expect((pageStore as Map<string, unknown>).size).toBe(0);
+    expect(await readdir(join(cwd, "references"))).toEqual(["paper.pdf"]);
+  });
+
+  test("fetches the current tab document when url is omitted", async () => {
+    const h = harness();
+    h.broker.pages.set(ARTICLE_TAB, { href: PDF_URL, window: {} });
+
+    const { structured } = await h.run({ browserId: ARTICLE_TAB, path: "current.pdf" });
+
+    expect(structured.ok).toBe(true);
+    expect(h.broker.fetchedUrls).toEqual([PDF_URL]);
+  });
+
+  test("a chunk above the desktop evaluate cap is reported as truncated, not written", async () => {
+    const h = harness({ chunkBytes: 60_000 });
+
+    const { structured } = await h.run({ url: PDF_URL, browserId: ARTICLE_TAB, path: "big.pdf" });
+
+    expect(errorCode(structured)).toBe("download_chunk_truncated");
+    expect(await readdir(cwd)).toEqual([]);
+  });
+
+  test("a corrupted chunk fails the SHA-256 check and nothing is written", async () => {
+    const h = harness();
+    h.broker.onChunkResult = (resultJson, index) =>
+      index === 1
+        ? resultJson.replace(/^"(.)/, (_m, c: string) => `"${c === "A" ? "B" : "A"}`)
+        : resultJson;
+
+    const { structured } = await h.run({ url: PDF_URL, browserId: ARTICLE_TAB, path: "bad.pdf" });
+
+    expect(errorCode(structured)).toBe("download_hash_mismatch");
+    expect(await readdir(cwd)).toEqual([]);
+  });
+
+  test("a short chunk fails the size check", async () => {
+    const h = harness();
+    h.broker.onChunkResult = (resultJson, index) =>
+      index === 0 ? `${resultJson.slice(0, -5)}"` : resultJson;
+
+    const { structured } = await h.run({ url: PDF_URL, browserId: ARTICLE_TAB, path: "short.pdf" });
+
+    expect(errorCode(structured)).toBe("download_size_mismatch");
+    expect(await readdir(cwd)).toEqual([]);
+  });
+
+  test("without crypto.subtle in the page the download is size-verified only", async () => {
+    const h = harness();
+    h.broker.pageHasSubtleCrypto = false;
+
+    const { text, structured } = await h.run({
+      url: PDF_URL,
+      browserId: ARTICLE_TAB,
+      path: "a.pdf",
+    });
+
+    expect(structured).toMatchObject({ ok: true, hashVerified: false, sha256: sha256(pdf) });
+    expect(text).toContain("size verified only");
+  });
+
+  test("a buffer lost to navigation mid-transfer is reported", async () => {
+    const h = harness();
+    h.broker.beforeChunk = (page, index) => {
+      if (index === 1) {
+        page.window = {};
+      }
+    };
+
+    const { structured } = await h.run({ url: PDF_URL, browserId: ARTICLE_TAB, path: "lost.pdf" });
+
+    expect(errorCode(structured)).toBe("download_buffer_lost");
+    expect(await readdir(cwd)).toEqual([]);
+  });
+
+  test("a page that rewrites its buffer cannot make the daemon exceed the size cap", async () => {
+    const h = harness();
+    h.broker.beforeStatus = (page) => {
+      const store = page.window.__paseoBrowserDownloads as Map<string, Record<string, unknown>>;
+      for (const entry of store.values()) {
+        if (entry.state === "ready") {
+          entry.size = 10 ** 12;
+        }
+      }
+    };
+
+    const { structured } = await h.run({ url: PDF_URL, browserId: ARTICLE_TAB, path: "huge.pdf" });
+
+    expect(errorCode(structured)).toBe("download_too_large");
+    expect(h.broker.chunkReadCount()).toBe(0);
+  });
+
+  test("openInNewTab fetches a cross-origin CDN redirect from its own tab and closes it", async () => {
+    const h = harness();
+
+    const fromArticle = await h.run({ url: CDN_LINK, browserId: ARTICLE_TAB, path: "cors.pdf" });
+    expect(errorCode(fromArticle.structured)).toBe("download_cors_or_network");
+    expect(fromArticle.text).toContain("openInNewTab");
+
+    const { structured } = await h.run({
+      url: CDN_LINK,
+      openInNewTab: true,
+      path: "cdn.pdf",
+      expectMagic: "%PDF-",
+    });
+
+    expect(structured).toMatchObject({ ok: true, finalUrl: CDN_URL, browserId: NEW_TAB });
+    expect((await readFile(join(cwd, "cdn.pdf"))).equals(Buffer.from(pdf))).toBe(true);
+    expect(h.broker.fetchedUrls.at(-1)).toBe(CDN_URL);
+    expect(h.broker.pages.has(NEW_TAB)).toBe(false);
+    expect(h.broker.calls.at(-1)?.command).toEqual({
+      command: "close_tab",
+      args: { browserId: NEW_TAB },
+    });
+    const commands = h.broker.calls.map((call) => call.command);
+    expect(commands).toContainEqual({ command: "new_tab", args: { url: CDN_LINK } });
+    expect(commands.some((command) => command.command === "navigate")).toBe(false);
+  });
+
+  test("a new tab that registers after the desktop's own wait is used, then closed", async () => {
+    const h = harness();
+    h.broker.newTabRegistration = { afterListCalls: 3 };
+
+    const { structured } = await h.run({ url: CDN_LINK, openInNewTab: true, path: "late.pdf" });
+
