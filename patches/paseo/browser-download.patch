+        const page = state.value as { href?: string; readyState?: string } | null;
+        if (page?.readyState === "complete" && /^https?:/i.test(page.href ?? "")) {
+          return { ok: true };
+        }
+      } else {
+        lastError = state.error.message;
+      }
+      if (Date.now() >= deadline) {
+        return failure(
+          "download_timeout",
+          `The new tab did not finish loading within ${timeoutMs}ms${lastError ? ` (${limitText(lastError)})` : ""}.`,
+          true,
+        );
+      }
+      await delay(this.pollIntervalMs());
+    }
+  }
+
+  private pollIntervalMs(): number {
+    return this.options.pollIntervalMs ?? BROWSER_DOWNLOAD_POLL_INTERVAL_MS;
+  }
+
+  public async transfer(params: {
+    browserId: string;
+    fetchUrl: string | null;
+    maxBytes: number;
+    timeoutMs: number;
+    expectMagic: string | undefined;
+    chunkBytes: number;
+    pollIntervalMs: number;
+  }): Promise<TransferSuccess | BrowserDownloadFailure> {
+    const token = randomUUID();
+    const started = await this.evaluate(
+      params.browserId,
+      buildStartScript({
+        token,
+        url: params.fetchUrl,
+        maxBytes: params.maxBytes,
+        timeoutMs: params.timeoutMs,
+      }),
+    );
+    if (!started.ok) {
+      return started;
+    }
+    const startValue = started.value as { ok?: boolean; code?: string; message?: string } | null;
+    if (!startValue || startValue.ok !== true) {
+      return pageFailure(startValue?.code ?? "page", startValue?.message ?? "start failed");
+    }
+    try {
+      return await this.collect({ ...params, token });
+    } finally {
+      await this.evaluate(params.browserId, buildFreeScript(token)).catch(() => undefined);
+    }
+  }
+
+  private async collect(params: {
+    browserId: string;
+    token: string;
+    maxBytes: number;
+    timeoutMs: number;
+    expectMagic: string | undefined;
+    chunkBytes: number;
+    pollIntervalMs: number;
+  }): Promise<TransferSuccess | BrowserDownloadFailure> {
+    const status = await this.waitForPage(params);
+    if (!status.ok) {
+      return status;
+    }
+    const page = status.page;
+    // Page scripts share the main world and could rewrite the entry, so its size is checked too.
+    const size = page.size ?? 0;
+    if (!Number.isSafeInteger(size) || size < 0 || size > params.maxBytes) {
+      return failure(
+        "download_too_large",
+        `The page reported ${limitText(String(page.size))} bytes; the limit is ${params.maxBytes}.`,
+      );
+    }
+    const pageSha256 = typeof page.sha256 === "string" ? page.sha256 : null;
+    if (
+      params.expectMagic &&
+      !headMatches(Buffer.from(page.head ?? "", "hex"), params.expectMagic)
+    ) {
+      return magicMismatch(
+        params.expectMagic,
+        Buffer.from(page.head ?? "", "hex"),
+        page.contentType,
+      );
+    }
+
+    const chunkCount = Math.ceil(size / params.chunkBytes);
+    const parts = await this.readChunks({ ...params, size, chunkCount });
+    if (!Array.isArray(parts)) {
+      return parts;
+    }
+
+    const data = Buffer.concat(parts);
+    if (data.byteLength !== size) {
+      return failure(
+        "download_size_mismatch",
+        `Reassembled ${data.byteLength} bytes; the page reported ${size}.`,
+      );
+    }
+    const sha256 = createHash("sha256").update(data).digest("hex");
+    if (pageSha256 !== null && sha256 !== pageSha256) {
+      return failure(
+        "download_hash_mismatch",
+        `SHA-256 on the daemon ${sha256} differs from the page ${pageSha256}.`,
+      );
+    }
+    if (params.expectMagic && !headMatches(data, params.expectMagic)) {
+      return magicMismatch(params.expectMagic, data, page.contentType);
+    }
+    return {
+      ok: true,
+      data,
+      sha256,
+      hashVerified: pageSha256 !== null,
+      contentType: limitText(page.contentType ?? ""),
+      finalUrl: limitText(page.finalUrl ?? ""),
+      httpStatus: page.status ?? 0,
+      chunks: chunkCount,
+    };
+  }
+
+  private async readChunks(params: {
+    browserId: string;
+    token: string;
+    chunkBytes: number;
+    size: number;
+    chunkCount: number;
+  }): Promise<Buffer[] | BrowserDownloadFailure> {
+    const parts: Buffer[] = Array.from({ length: params.chunkCount }, () => Buffer.alloc(0));
+    const state: { next: number; failed: BrowserDownloadFailure | null } = {
+      next: 0,
+      failed: null,
+    };
+    const readNext = async (): Promise<void> => {
+      while (state.failed === null && state.next < params.chunkCount) {
+        const index = state.next++;
+        const start = index * params.chunkBytes;
+        const end = Math.min(params.size, start + params.chunkBytes);
+        const chunk = await this.readChunk(params.browserId, params.token, start, end);
+        if (!chunk.ok) {
+          state.failed ??= chunk;
+          return;
+        }
+        parts[index] = chunk.data;
+      }
+    };
+    const workers = Math.min(BROWSER_DOWNLOAD_CHUNK_CONCURRENCY, params.chunkCount);
+    await Promise.all(Array.from({ length: workers }, readNext));
+    return state.failed ?? parts;
+  }
+
+  private async waitForPage(params: {
+    browserId: string;
+    token: string;
+    timeoutMs: number;
+    pollIntervalMs: number;
+  }): Promise<{ ok: true; page: PageDownloadStatus } | BrowserDownloadFailure> {
+    // The page aborts its own fetch at timeoutMs; the grace lets that error arrive first.
+    const deadline = Date.now() + params.timeoutMs + 5_000;
+    for (;;) {
+      const polled = await this.evaluate(params.browserId, buildStatusScript(params.token));
+      if (!polled.ok) {
+        return polled;
+      }
+      const page = polled.value as PageDownloadStatus | null;
+      if (!page || page.state === "missing") {
+        return failure(
+          "download_buffer_lost",
+          "The page-side download buffer disappeared; the tab probably navigated or reloaded.",
+          true,
+        );
+      }
+      if (page.state === "ready") {
+        return { ok: true, page };
+      }
+      if (page.state === "error") {
+        return pageFailure(page.code ?? "page", page.message ?? "", page);
+      }
+      if (Date.now() >= deadline) {
+        return failure(
+          "download_timeout",
+          `The page fetch did not finish within ${params.timeoutMs}ms.`,
+          true,
+        );
+      }
+      await delay(params.pollIntervalMs);
+    }
+  }
+
+  private async readChunk(
+    browserId: string,
+    token: string,
+    start: number,
+    end: number,
+  ): Promise<{ ok: true; data: Buffer } | BrowserDownloadFailure> {
+    const read = await this.evaluate(browserId, buildChunkScript(token, start, end));
+    if (!read.ok) {
+      return read;
+    }
+    if (read.truncated) {
+      return failure(
+        "download_chunk_truncated",
+        `The browser host truncated the chunk at byte ${start}; the chunk size is too large for this host.`,
+      );
+    }
+    if (typeof read.value !== "string") {
+      return failure(
+        "download_buffer_lost",
+        `The page-side download buffer disappeared while reading byte ${start}.`,
+        true,
+      );
+    }
+    const data = Buffer.from(read.value, "base64");
+    if (data.byteLength !== end - start) {
+      return failure(
+        "download_size_mismatch",
+        `Chunk at byte ${start} decoded to ${data.byteLength} bytes; expected ${end - start}.`,
+      );
+    }
+    return { ok: true, data };
+  }
+
+  private async evaluate(
+    browserId: string,
+    functionSource: string,
+  ): Promise<{ ok: true; value: unknown; truncated: boolean } | BrowserDownloadFailure> {
+    const payload = await this.execute({
+      command: "evaluate",
+      args: { browserId, function: functionSource },
+    });
+    if (!payload.ok) {
+      return brokerFailure(payload);
+    }
+    if (payload.result.command !== "evaluate") {
+      return failure("download_page_error", "browser evaluate returned an unexpected result.");
+    }
+    if (payload.result.truncated) {
+      return { ok: true, value: null, truncated: true };
+    }
+    try {
+      return { ok: true, value: JSON.parse(payload.result.resultJson), truncated: false };
+    } catch {
+      return failure("download_page_error", "browser evaluate returned invalid JSON.");
+    }
+  }
+
+  private execute(
+    command: BrowserToolsExecuteInput["command"],
+    timeoutMs: number = BROWSER_DOWNLOAD_COMMAND_TIMEOUT_MS,
+  ): Promise<BrowserToolsResponsePayload> {
+    return this.options.broker.execute({
+      ...(this.context.agentId ? { agentId: this.context.agentId } : {}),
+      ...(this.context.cwd ? { cwd: this.context.cwd } : {}),
+      ...(this.context.workspaceId ? { workspaceId: this.context.workspaceId } : {}),
+      timeoutMs,
+      command,
+    });
+  }
+}
+
+// In-page scripts. They run in the tab's main world with the page's cookies; the bytes stay in
+// a token-keyed buffer until the daemon frees it or the page unloads.
+
+const PAGE_STORE = "window.__paseoBrowserDownloads";
+
+function buildStartScript(params: {
+  token: string;
+  url: string | null;
+  maxBytes: number;
+  timeoutMs: number;
+}): string {
+  return `async () => {
+  const store = (${PAGE_STORE} ??= new Map());
+  const token = ${JSON.stringify(params.token)};
+  const maxBytes = ${params.maxBytes};
+  const target = ${params.url === null ? "location.href" : JSON.stringify(params.url)};
+  if (!/^https?:$/i.test(new URL(target, location.href).protocol)) {
+    return { ok: false, code: "invalid_url", message: "the tab URL is not http(s): " + String(target).slice(0, 200) };
+  }
+  const entry = { state: "pending" };
+  store.set(token, entry);
+  const controller = new AbortController();
+  entry.abort = () => controller.abort();
+  const timer = setTimeout(() => { entry.timedOut = true; controller.abort(); }, ${params.timeoutMs});
+  const fail = (code, message) => { entry.state = "error"; entry.code = code; entry.message = String(message).slice(0, 500); };
+  const hex = (bytes) => Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+  (async () => {
+    let response;
+    try {
+      response = await fetch(target, { credentials: "include", redirect: "follow", cache: "no-store", signal: controller.signal });
+    } catch (error) {
+      fail(entry.timedOut ? "timeout" : "network", error && error.message ? error.message : error);
+      return;
+    }
+    entry.status = response.status;
+    entry.finalUrl = response.url || target;
+    entry.contentType = response.headers.get("content-type") || "";
+    if (response.status !== 200) {
+      fail("http_status", "HTTP " + response.status);
+      try { await response.body?.cancel(); } catch {}
+      return;
+    }
+    const declared = Number(response.headers.get("content-length"));
+    if (Number.isFinite(declared) && declared > maxBytes) {
+      fail("too_large", "Content-Length " + declared + " exceeds " + maxBytes);
+      try { await response.body?.cancel(); } catch {}
+      return;
+    }
+    const parts = [];
+    let total = 0;
+    if (response.body) {
+      const reader = response.body.getReader();
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        total += value.byteLength;
+        if (total > maxBytes) {
+          fail("too_large", "body exceeds " + maxBytes + " bytes");
+          try { await reader.cancel(); } catch {}
+          return;
+        }
+        parts.push(value);
+      }
+    }
+    const bytes = new Uint8Array(total);
+    let offset = 0;
+    for (const part of parts) { bytes.set(part, offset); offset += part.byteLength; }
+    entry.bytes = bytes;
+    entry.size = total;
+    entry.head = hex(bytes.subarray(0, ${BROWSER_DOWNLOAD_HEAD_BYTES}));
+    entry.sha256 = globalThis.crypto?.subtle ? hex(new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))) : null;
+    entry.state = "ready";
+  })().catch((error) => fail(entry.timedOut ? "timeout" : "page", error && error.message ? error.message : error))
+    .finally(() => clearTimeout(timer));
+  return { ok: true };
+}`;
+}
+
+function buildStatusScript(token: string): string {
+  return `() => {
+  const entry = ${PAGE_STORE}?.get(${JSON.stringify(token)});
+  if (!entry) return { state: "missing" };
+  const { state, code, message, status, finalUrl, contentType, size, sha256, head } = entry;
+  return { state, code, message, status, finalUrl, contentType, size, sha256, head };
+}`;
+}
+
+function buildChunkScript(token: string, start: number, end: number): string {
+  return `() => {
+  const entry = ${PAGE_STORE}?.get(${JSON.stringify(token)});
+  if (!entry || !entry.bytes) return null;
+  const slice = entry.bytes.subarray(${start}, ${end});
+  let binary = "";
+  for (let i = 0; i < slice.length; i += 8192) {
+    binary += String.fromCharCode.apply(null, slice.subarray(i, i + 8192));
+  }
+  return btoa(binary);
+}`;
+}
+
+function buildFreeScript(token: string): string {
+  return `() => {
+  const store = ${PAGE_STORE};
+  const entry = store?.get(${JSON.stringify(token)});
+  if (entry) { entry.abort?.(); store.delete(${JSON.stringify(token)}); }
+  return true;
+}`;
+}
+
+// Destination handling.
+
+async function resolveDownloadDestination(params: {
+  requestedPath: string;
+  cwd: string | undefined;
+  allowedRoots: string[] | null;
+  overwrite: boolean;
+}): Promise<{ ok: true; path: string } | BrowserDownloadFailure> {
+  const { requestedPath, cwd } = params;
+  const configuredRoots = params.allowedRoots ?? (cwd ? [cwd] : []);
+  if (configuredRoots.length === 0) {
+    return failure(
+      "download_destination_denied",
+      "No allowed download root: the agent has no cwd and daemon.browserTools.download.allowedRoots is unset.",
+    );
+  }
+  const trimmed = requestedPath.trim();
+  let absolute: string | null = null;
+  if (cwd) {
+    absolute = resolvePathFromBase(cwd, trimmed);
+  } else if (isAbsolute(trimmed) || trimmed.startsWith("~/")) {
+    absolute = expandUserPath(trimmed);
+  }
+  if (!absolute || trimmed.endsWith("/")) {
+    return failure(
+      "download_destination_denied",
+      `Destination is not a file path: ${requestedPath}`,
+    );
+  }
+  const parent = await realpathOfNearestExistingAncestor(dirname(absolute));
+  const destination = join(parent, basename(absolute));
+  const roots = await Promise.all(
+    configuredRoots.map((root) => realpath(expandUserPath(root)).catch(() => null)),
+  );
+  if (!roots.some((root) => root !== null && isSameOrDescendantPath(root, parent))) {
+    return failure(
+      "download_destination_denied",
+      `Destination ${destination} is outside the allowed download roots.`,
+    );
+  }
+  const existing = await lstat(destination).catch(() => null);
+  if (existing?.isDirectory()) {
+    return failure("download_destination_denied", `Destination ${destination} is a directory.`);
+  }
+  if (existing && !params.overwrite) {
+    return failure(
+      "download_destination_exists",
+      `Destination ${destination} exists; pass overwrite: true to replace it.`,
+    );
+  }
+  return { ok: true, path: destination };
+}
+
+async function realpathOfNearestExistingAncestor(directory: string): Promise<string> {
+  const missing: string[] = [];
+  let current = directory;
+  for (;;) {
+    const resolved = await realpath(current).catch(() => null);
+    if (resolved !== null) {
+      return join(resolved, ...missing);
+    }
+    const up = dirname(current);
+    if (up === current) {
+      return join(current, ...missing);
+    }
+    missing.unshift(basename(current));
+    current = up;
+  }
+}
+
+async function writeFileAtomically(params: {
+  path: string;
+  data: Buffer;
+  overwrite: boolean;
+}): Promise<{ ok: true } | BrowserDownloadFailure> {
+  const directory = dirname(params.path);
+  const temporary = join(directory, `.${basename(params.path)}.paseo-download-${randomUUID()}.tmp`);
+  try {
+    await mkdir(directory, { recursive: true });
+    const handle = await open(temporary, "wx", 0o644);
+    try {
+      await handle.writeFile(params.data);
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+    if (params.overwrite) {
+      await rename(temporary, params.path);
+      return { ok: true };
+    }
+    // link() refuses an existing target, so a file created since the precheck is never replaced.
+    await link(temporary, params.path);
+    await unlink(temporary);
+    return { ok: true };
+  } catch (error) {
+    await unlink(temporary).catch(() => undefined);
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code === "EEXIST") {
+      return failure(
+        "download_destination_exists",
+        `Destination ${params.path} appeared during the download; it was not replaced.`,
+      );
+    }
+    return failure(
+      "download_write_failed",
+      `Writing ${params.path} failed: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+}
+
+// Results and errors.
+
+function resolveDownloadContext(
+  options: RegisterBrowserDownloadToolOptions,
+): BrowserDownloadContext {
+  const callerAgent = options.resolveCallerAgent();
+  return {
+    ...(options.callerAgentId ? { agentId: options.callerAgentId } : {}),
+    ...(callerAgent?.cwd ? { cwd: callerAgent.cwd } : {}),
+    ...(callerAgent?.workspaceId ? { workspaceId: callerAgent.workspaceId } : {}),
+  };
+}
+
+function browserDownloadResult(
+  outcome: BrowserDownloadOutcome,
+  context: BrowserDownloadContext,
+): PaseoToolResult {
+  if (!outcome.ok) {
+    return {
+      content: [
+        {
+          type: "text",
+          text: `browser_download failed [${outcome.error.code}]: ${outcome.error.message}`,
+        },
+      ],
+      structuredContent: { ...outcome, context },
+    };
+  }
+  const lines = [
+    `Downloaded ${outcome.bytes} bytes to ${outcome.path}.`,
+    `sha256=${outcome.sha256} (${outcome.hashVerified ? "matches the page" : "page hash unavailable; size verified only"})`,
+    `contentType=${JSON.stringify(outcome.contentType)} httpStatus=${outcome.httpStatus}`,
+    `finalUrl=${outcome.finalUrl}`,
+    ...(outcome.magic ? [`magic ${JSON.stringify(outcome.magic.expected)} matched`] : []),
+  ];
+  return {
+    content: [{ type: "text", text: lines.join("\n") }],
+    structuredContent: { ...outcome, context },
+  };
+}
+
+function failure(
+  code: BrowserDownloadErrorCode,
+  message: string,
+  retryable = false,
+): BrowserDownloadFailure {
+  return { ok: false, error: { code, message, retryable } };
+}
+
+function registrationTimeoutBrowserId(
+  payload: Extract<BrowserToolsResponsePayload, { ok: false }>,
+): string | null {
+  if (payload.error.code !== "browser_timeout") {
+    return null;
+  }
+  const candidate = NEW_TAB_REGISTRATION_TIMEOUT_PATTERN.exec(payload.error.message)?.[1];
+  return candidate && BrowserAutomationBrowserIdSchema.safeParse(candidate).success
+    ? candidate
+    : null;
+}
+
+function brokerFailure(payload: Extract<BrowserToolsResponsePayload, { ok: false }>) {
+  return {
+    ok: false as const,
+    error: {
+      code: payload.error.code,
+      message: payload.error.message,
+      retryable: payload.error.retryable,
+    },
+  };
+}
+
+function pageFailure(
+  code: string,
+  message: string,
+  page?: PageDownloadStatus,
+): BrowserDownloadFailure {
+  const finalUrl = page?.finalUrl ? ` finalUrl=${limitText(page.finalUrl)}` : "";
+  switch (code) {
+    case "network":
+      return failure(
+        "download_cors_or_network",
+        `The in-page fetch failed (${limitText(message)}). For a link that redirects to another origin, retry with openInNewTab: true.`,
+        true,
+      );
+    case "http_status":
+      return failure(
+        "download_http_status",
+        `The server answered HTTP ${page?.status ?? "?"}, not 200.${finalUrl}`,
+      );
+    case "too_large":
+      return failure("download_too_large", limitText(message));
+    case "timeout":
+      return failure("download_timeout", `The in-page fetch timed out.${finalUrl}`, true);
+    case "invalid_url":
+      return failure("download_invalid_input", limitText(message));
+    default:
+      return failure("download_page_error", limitText(message || "the page script failed"));
+  }
+}
+
+function magicMismatch(
+  expected: string,
+  data: Buffer,
+  contentType: string | undefined,
+): BrowserDownloadFailure {
+  const head = data.subarray(0, BROWSER_DOWNLOAD_HEAD_BYTES);
+  const printable = Array.from(head, (byte) =>
+    byte >= 0x20 && byte < 0x7f ? String.fromCharCode(byte) : ".",
+  ).join("");
+  return failure(
+    "download_magic_mismatch",
+    `Expected leading bytes ${JSON.stringify(expected)}; got ${JSON.stringify(printable)} (hex ${head.toString("hex")}), contentType=${JSON.stringify(limitText(contentType ?? ""))}. Nothing was written.`,
+  );
+}
+
+function headMatches(data: Buffer, expected: string): boolean {
+  const prefix = Buffer.from(expected, "latin1");
+  return data.byteLength >= prefix.byteLength && data.subarray(0, prefix.byteLength).equals(prefix);
+}
+
+function isExplicitHttpUrl(value: string): boolean {
+  if (!/^https?:\/\//i.test(value)) {
+    return false;
+  }
+  try {
+    const url = new URL(value);
+    return url.protocol === "http:" || url.protocol === "https:";
+  } catch {
+    return false;
+  }
+}
+
+// Text that comes from the page or the server is shown to the model, so keep it short and plain.
+function limitText(value: string): string {
+  const printable = value.replace(/[^\x20-\x7e]/g, "?");
+  return printable.length <= BROWSER_DOWNLOAD_TEXT_FIELD_LIMIT
+    ? printable
+    : `${printable.slice(0, BROWSER_DOWNLOAD_TEXT_FIELD_LIMIT)}...`;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
