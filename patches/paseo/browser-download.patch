+        "Destination file, absolute or relative to the agent cwd. Must be in an allowed root.",
+      ),
+    overwrite: z.boolean().optional().describe("Replace an existing file. Default false."),
+    openInNewTab: z
+      .boolean()
+      .optional()
+      .describe(
