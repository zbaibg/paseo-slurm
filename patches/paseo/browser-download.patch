+
+export function readBrowserDownloadSettings(params: {
+  enabled: boolean;
+  downloadConfig: unknown;
+}): BrowserDownloadSettings {
+  const base: BrowserDownloadSettings = {
+    enabled: params.enabled,
+    allowedRoots: null,
+    maxBytes: BROWSER_DOWNLOAD_DEFAULT_MAX_BYTES,
+  };
+  if (params.downloadConfig === undefined) {
+    return base;
+  }
+  const parsed = BrowserDownloadSettingsFileSchema.safeParse(params.downloadConfig);
+  if (!parsed.success) {
+    return {
+      ...base,
+      configError: `daemon.browserTools.download is invalid: ${parsed.error.issues[0]?.message ?? "unknown error"}`,
+    };
+  }
+  return {
+    ...base,
+    ...(parsed.data.allowedRoots ? { allowedRoots: parsed.data.allowedRoots } : {}),
+    ...(parsed.data.maxBytes ? { maxBytes: parsed.data.maxBytes } : {}),
+  };
+}
+
+async function executeBrowserDownload(params: {
+  options: RegisterBrowserDownloadToolOptions;
+  context: BrowserDownloadContext;
+  input: BrowserDownloadInput;
+}): Promise<BrowserDownloadOutcome> {
+  const { options, context, input } = params;
+  const settings = options.readSettings();
+  if (!settings.enabled) {
+    return failure(
+      "browser_disabled",
+      "Browser tools are disabled in the daemon config (daemon.browserTools.enabled).",
+    );
+  }
+  if (settings.configError) {
+    return failure("download_config_invalid", settings.configError);
+  }
+  if (input.maxBytes !== undefined && input.maxBytes > settings.maxBytes) {
+    return failure(
+      "download_invalid_input",
+      `maxBytes ${input.maxBytes} exceeds the daemon cap ${settings.maxBytes}.`,
+    );
+  }
+  const maxBytes = input.maxBytes ?? settings.maxBytes;
+  const timeoutMs = input.timeoutMs ?? BROWSER_DOWNLOAD_DEFAULT_TIMEOUT_MS;
+
+  const destination = await resolveDownloadDestination({
+    requestedPath: input.path,
+    cwd: context.cwd,
+    allowedRoots: settings.allowedRoots,
+    overwrite: input.overwrite === true,
+  });
