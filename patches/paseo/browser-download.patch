+
+  public async openTab(
+    url: string,
+    timeoutMs: number,
+  ): Promise<{ ok: true; browserId: string } | BrowserDownloadFailure> {
+    const before = await this.listTabs();
+    // Open on the target directly: without a URL the desktop app opens https://example.com.
+    const created = await this.execute({ command: "new_tab", args: { url } });
+    let browserId: string;
+    if (created.ok) {
+      if (created.result.command !== "new_tab") {
+        return failure("download_page_error", "browser_new_tab returned an unexpected result.");
+      }
+      browserId = created.result.browserId;
+      this.openedTabs.add(browserId);
+    } else {
+      const pending = registrationTimeoutBrowserId(created);
+      if (!pending) {
+        if (created.error.code === "browser_timeout") {
+          await this.adoptNewTabs(before, url);
+        }
+        return brokerFailure(created);
+      }
+      this.openedTabs.add(pending);
+      const waitMs =
+        this.options.tabRegistrationWaitMs ?? BROWSER_DOWNLOAD_TAB_REGISTRATION_WAIT_MS;
+      if (!(await this.waitForListedTab(pending, waitMs))) {
+        return failure(
+          "browser_timeout",
+          `The new browser tab ${pending} did not register with the browser host within ${Math.round(waitMs / 1000)} s; it is being closed.`,
