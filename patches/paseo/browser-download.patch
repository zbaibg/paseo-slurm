+      if (adopted.length === 0 && fresh.length === 1) {
+        adopted = fresh;
+      }
+      if (adopted.length > 0) {
+        for (const tab of adopted) this.openedTabs.add(tab.browserId);
+        return;
+      }
+      if (Date.now() >= deadline) {
+        return;
+      }
+      await delay(this.pollIntervalMs());
+    }
+  }
+
+  private async waitForTabLoad(
+    browserId: string,
+    timeoutMs: number,
+  ): Promise<{ ok: true } | BrowserDownloadFailure> {
+    const deadline = Date.now() + timeoutMs;
+    let lastError = "";
+    for (;;) {
+      const state = await this.evaluate(
+        browserId,
+        "() => ({ href: location.href, readyState: document.readyState })",
+      );
