+const BrowserDownloadInputSchema = z
+  .object({
+    url: BrowserDownloadHttpUrlSchema.optional().describe(
+      "http(s) URL to fetch. Omit to fetch the document currently shown in browserId.",
+    ),
+    browserId: BrowserAutomationBrowserIdSchema.optional().describe(
+      "Tab whose session performs the fetch. Required unless openInNewTab is true.",
+    ),
+    path: z
+      .string()
+      .min(1)
