+const BROWSER_DOWNLOAD_HEAD_BYTES = 16;
+const BROWSER_DOWNLOAD_TEXT_FIELD_LIMIT = 500;
+
+export type BrowserDownloadErrorCode =
+  | "browser_disabled"
+  | "browser_denied"
