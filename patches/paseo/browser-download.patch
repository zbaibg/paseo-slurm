+}
+
+interface BrowserDownloadContext {
+  agentId?: string;
+  cwd?: string;
+  workspaceId?: string;
+}
+
+export interface BrowserDownloadInput {
+  url?: string;
+  browserId?: string;
+  path: string;
+  overwrite?: boolean;
+  openInNewTab?: boolean;
+  maxBytes?: number;
+  expectMagic?: string;
