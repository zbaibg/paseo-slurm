+// Claude Code budgets a bare id at 200k when ANTHROPIC_BASE_URL is not the
+// official API. Direct Anthropic already knows these 1M models, so an unset or
+// official base URL must keep the catalog id.
+export function claudeBaseUrlUsesGateway(baseUrl: string | null | undefined): boolean {
+  if (typeof baseUrl !== "string") {
+    return false;
+  }
+  const trimmed = baseUrl.trim();
+  if (trimmed.length === 0) {
+    return false;
+  }
+  const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
+  try {
+    const host = new URL(withScheme).hostname.toLowerCase().replace(/\.$/, "");
+    return host !== ANTHROPIC_API_HOST;
+  } catch {
+    return true;
+  }
+}
+
+export function claudeLaunchModelId(
+  modelId: string | null | undefined,
+  baseUrl?: string | null,
+): string | null | undefined {
+  if (typeof modelId !== "string") {
+    return modelId;
+  }
+  const trimmed = modelId.trim();
+  if (
+    trimmed.length === 0 ||
+    !claudeBaseUrlUsesGateway(baseUrl) ||
+    trimmed.toLowerCase().endsWith(CLAUDE_ONE_MILLION_SUFFIX)
+  ) {
+    return trimmed;
+  }
+  const entry = CLAUDE_MODEL_MANIFEST.find((model) => model.id === trimmed);
+  if (!entry || entry.contextWindowMaxTokens !== CLAUDE_ONE_MILLION_CONTEXT_TOKENS) {
+    return trimmed;
+  }
+  if (isClaudeManifestModelId(`${trimmed}${CLAUDE_ONE_MILLION_SUFFIX}`)) {
+    return trimmed;
+  }
+  return `${trimmed}${CLAUDE_ONE_MILLION_SUFFIX}`;
+}
