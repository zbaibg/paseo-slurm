@@ -141,6 +143,25 @@ function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value);
 }
 
+export function readClaudeSettingsAnthropicBaseUrl(configDir?: string): string | undefined {
+  const settingsPath = path.join(configDir ?? claudeConfigDir(process.env), "settings.json");
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(readFileSync(settingsPath, "utf8"));
+  } catch {
+    return undefined;
+  }
+  if (!isRecord(parsed) || !isRecord(parsed.env)) {
+    return undefined;
+  }
+  const value = parsed.env.ANTHROPIC_BASE_URL;
+  if (typeof value !== "string") {
+    return undefined;
+  }
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : undefined;
+}
