+    expect(claudeLaunchModelId("claude-opus-5-5[1m]", gateway)).toBe("claude-opus-5-5[1m]");
+    expect(claudeLaunchModelId("claude-opus-4-8", gateway)).toBe("claude-opus-4-8");
+    expect(claudeLaunchModelId("claude-opus-4-8[1m]", gateway)).toBe("claude-opus-4-8[1m]");
+    expect(claudeLaunchModelId("claude-sonnet-5", gateway)).toBe("claude-sonnet-5");
+    expect(claudeLaunchModelId("claude-sonnet-5[1m]", gateway)).toBe("claude-sonnet-5[1m]");
