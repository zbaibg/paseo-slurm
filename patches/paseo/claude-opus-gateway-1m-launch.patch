+  it("launches bare 1M catalog ids with the suffix only for a gateway base URL", () => {
+    const gateway = "http://127.0.0.1:18764";
+    expect(claudeBaseUrlUsesGateway(gateway)).toBe(true);
+    expect(claudeBaseUrlUsesGateway("https://api.anthropic.com")).toBe(false);
+    expect(claudeBaseUrlUsesGateway("https://api.anthropic.com/v1")).toBe(false);
+    expect(claudeBaseUrlUsesGateway(undefined)).toBe(false);
+    expect(claudeBaseUrlUsesGateway("")).toBe(false);
