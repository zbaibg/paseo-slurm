+    // Codex holds an exclusive thread writer until the previous app-server exits.
+    // Spawning the replacement and calling thread/resume first deadlocks reload:
+    // the new process fails with "already has an active writer".
+    this.cancelRunningProviderSubagents(agentId);
+    this.logger.debug(
+      { agentId, provider },
+      "Closing previous session before reload resume",
+    );
+    await this.closeReloadedSession(existing.session, agentId);
+
+    let session: AgentSession;
+    try {
+      session = handle
+        ? await client.resumeSession(handle, providerLaunchConfig, launchContext)
+        : await client.createSession(providerLaunchConfig, launchContext);
+      await this.requireExternalMcpSupport(session, storedConfig);
+    } catch (error) {
+      // The previous writer is already gone. Do not leave the visible agent idle
+      // with that closed session, or the next prompt would call startTurn on it.
+      await this.finalizeFailedReload(existing, agentId);
+      throw error;
+    }
 
