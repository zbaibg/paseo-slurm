@@ -1428,6 +1441,19 @@ export class AgentManager {
     }
   }
 
+  private async finalizeFailedReload(existing: LiveManagedAgent, agentId: string): Promise<void> {
+    const closedExisting = this.prepareAgentForClosure(existing, "agent reload failed");
+    try {
+      await this.persistSnapshot(closedExisting);
+    } catch (error) {
+      this.logger.warn(
+        { err: error, agentId },
+        "Failed to persist closed snapshot after reload replacement failure",
+      );
+    }
+    this.emitClosedAgent(closedExisting, { persist: false });
+  }
+
