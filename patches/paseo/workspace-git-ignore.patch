   await rm(obsoleteTimelineDirectory, { recursive: true, force: true }).catch((error) => {
     logger.warn(
@@ -1889,3 +1900,23 @@ async function closeAllAgents(logger: Logger, agentManager: AgentManager): Promi
     }),
   );
 }
+
+function logGitIntegrationStatus(
+  logger: Logger,
+  status: GitIntegrationStatus,
+  when: "startup" | "changed",
+): void {
+  if (!status.enabled) {
+    logger.info(
+      { when, disabledBy: status.disabledBy },
+      "Daemon git integration is disabled: no git or forge CLI processes, watchers or polls",
+    );
+  } else if (status.ignoredPaths.length > 0) {
+    logger.info(
+      { when, gitIgnoredPaths: status.ignoredPaths },
+      "Git workspace integration disabled for ignored paths",
+    );
+  } else if (when === "changed") {
+    logger.info({ when }, "Daemon git integration is enabled for all workspaces");
+  }
+}
