+import { mkdir, mkdtemp, realpath, rm, symlink, utimes, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+
+const spawned = vi.hoisted(() => [] as Array<{ command: string; cwd: string | undefined }>);
+
+vi.mock("./spawn.js", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("./spawn.js")>();
+  return {
+    ...actual,
+    spawnProcess: (...args: Parameters<typeof actual.spawnProcess>) => {
+      spawned.push({ command: args[0], cwd: args[2]?.cwd?.toString() });
+      return actual.spawnProcess(...args);
+    },
+    execCommand: (...args: Parameters<typeof actual.execCommand>) => {
+      spawned.push({ command: args[0], cwd: args[2]?.cwd?.toString() });
+      return actual.execCommand(...args);
+    },
+  };
+});
+
+import { createForgeCliRunner } from "../services/forge-cli-command.js";
+import { getCheckoutStatus } from "./checkout-git.js";
+import {
+  configureGitIgnoredPaths,
+  getGitIgnoredPaths,
+  GIT_IGNORED_PATHS_ENV,
+  isGitIgnoredPath,
+  resetGitIgnoredPaths,
+} from "./git-ignored-paths.js";
+import {
+  getGitCommandMetrics,
+  runGitCommand,
+  startGitCommandMetrics,
+  stopGitCommandMetrics,
+} from "./run-git-command.js";
+
+class TestCommandError extends Error {
+  public constructor(public readonly params: { exitCode: number | null; stderr: string }) {
+    super(`test CLI failed (${String(params.exitCode)})`);
+  }
+}
+
+function createTestForgeRunner() {
+  return createForgeCliRunner({
+    binary: "paseo-test-forge-cli-that-does-not-exist",
+    envOverlay: {},
+    timeoutMs: 5_000,
+    isAuthFailureText: () => false,
+    errorClasses: {
+      isAlreadyClassified: () => false,
+      isCommandError: (error): error is TestCommandError & { stderr: string } =>
+        error instanceof TestCommandError,
+      createAuthError: () => new Error("auth"),
+      createMissingError: () => new Error("missing"),
+      createCommandError: (params) => new TestCommandError(params),
+    },
+  });
+}
+
+describe("daemon.git.ignoredPaths", () => {
+  let root: string;
+
+  beforeEach(async () => {
+    root = await realpath(await mkdtemp(path.join(os.tmpdir(), "paseo-git-ignored-")));
+    spawned.length = 0;
+  });
+
+  afterEach(async () => {
+    resetGitIgnoredPaths();
+    await rm(root, { recursive: true, force: true });
+  });
+
+  test("matches the path and its descendants, not siblings sharing a prefix", () => {
+    configureGitIgnoredPaths({
+      env: { [GIT_IGNORED_PATHS_ENV]: `${root}/a/b/::relative/path` },
+    });
+
+    expect(getGitIgnoredPaths()).toEqual([`${root}/a/b`]);
+    expect(isGitIgnoredPath(`${root}/a/b`)).toBe(true);
+    expect(isGitIgnoredPath(`${root}/a/b/`)).toBe(true);
+    expect(isGitIgnoredPath(`${root}/a/b/c/d`)).toBe(true);
+    expect(isGitIgnoredPath(`${root}/a/bc`)).toBe(false);
+    expect(isGitIgnoredPath(`${root}/a/b/../bc`)).toBe(false);
+    expect(isGitIgnoredPath(`${root}/a`)).toBe(false);
+    expect(isGitIgnoredPath("relative/path")).toBe(false);
+  });
+
+  test("follows symlinks in both the workspace cwd and the configured path", async () => {
+    await mkdir(path.join(root, "repo/sub"), { recursive: true });
+    await mkdir(path.join(root, "other/sub"), { recursive: true });
+    await symlink(path.join(root, "repo"), path.join(root, "repo-link"));
+    await symlink(path.join(root, "other"), path.join(root, "other-link"));
+    configureGitIgnoredPaths({
+      env: { [GIT_IGNORED_PATHS_ENV]: `${root}/repo:${root}/other-link` },
+    });
+
+    expect(isGitIgnoredPath(`${root}/repo-link`)).toBe(true);
+    expect(isGitIgnoredPath(`${root}/repo-link/sub`)).toBe(true);
+    expect(isGitIgnoredPath(`${root}/other/sub`)).toBe(true);
+    expect(isGitIgnoredPath(`${root}/other-link/sub`)).toBe(true);
+  });
+
+  test("merges config.json and the environment, and rereads a changed config", async () => {
+    let now = 1_000_000;
+    const configPath = path.join(root, "config.json");
+    await writeFile(
+      configPath,
+      JSON.stringify({ daemon: { git: { ignoredPaths: ["/data/a", "/data/b"] } } }),
+    );
+    configureGitIgnoredPaths({
+      env: { [GIT_IGNORED_PATHS_ENV]: "/data/b:/data/c" },
+      configPath,
+      now: () => now,
+    });
+
+    expect(getGitIgnoredPaths()).toEqual(["/data/a", "/data/b", "/data/c"]);
+
+    await writeFile(configPath, JSON.stringify({ daemon: { git: { ignoredPaths: ["/data/d"] } } }));
+    const later = new Date(Date.now() + 60_000);
+    await utimes(configPath, later, later);
+    now += 4_000;
+    expect(isGitIgnoredPath("/data/a/x")).toBe(true);
+    now += 1_000;
+    expect(isGitIgnoredPath("/data/a/x")).toBe(false);
+    expect(getGitIgnoredPaths()).toEqual(["/data/d", "/data/b", "/data/c"]);
+  });
+
+  test("without configuration nothing is ignored", () => {
+    expect(isGitIgnoredPath(root)).toBe(false);
+    configureGitIgnoredPaths({ env: {} });
+    expect(isGitIgnoredPath(root)).toBe(false);
+  });
+
+  test("git in an ignored cwd answers 'not a git repository' without a process", async () => {
+    const repo = path.join(root, "repo");
+    const plain = path.join(root, "plain");
+    await mkdir(repo);
+    await mkdir(plain);
+    await runGitCommand(["init", "--quiet"], { cwd: repo });
+    configureGitIgnoredPaths({ env: { [GIT_IGNORED_PATHS_ENV]: repo } });
+    spawned.length = 0;
+    startGitCommandMetrics();
+
+    await expect(runGitCommand(["status", "--porcelain"], { cwd: repo })).rejects.toThrow(
+      /not a git repository/,
+    );
+    await expect(
+      runGitCommand(["rev-parse", "--show-toplevel"], { cwd: path.join(repo, "sub/dir") }),
+    ).rejects.toThrow(/exit code: 128/);
+    const accepted = await runGitCommand(["rev-parse", "--git-dir"], {
+      cwd: repo,
+      acceptExitCodes: [0, 128],
+    });
+    expect(accepted).toMatchObject({ exitCode: 128, stdout: "" });
+    expect(await getCheckoutStatus(repo)).toMatchObject({ isGit: false });
+    expect(spawned).toEqual([]);
+    expect(getGitCommandMetrics().submitted).toBe(0);
+
+    await expect(runGitCommand(["rev-parse", "--git-dir"], { cwd: plain })).rejects.toThrow(
+      /not a git repository/i,
+    );
+    expect(spawned).toEqual([{ command: "git", cwd: plain }]);
+    stopGitCommandMetrics();
+
+    resetGitIgnoredPaths();
+    expect(await getCheckoutStatus(repo)).toMatchObject({ isGit: true });
+  });
+
+  test("forge CLIs are not started in an ignored cwd", async () => {
+    const runner = createTestForgeRunner();
+    configureGitIgnoredPaths({ env: { [GIT_IGNORED_PATHS_ENV]: `${root}/repo` } });
+
+    const ignored = await runner.run(["pr", "status"], { cwd: `${root}/repo` }).catch((e) => e);
