index 0000000..c7fe426
--- /dev/null
+++ b/packages/server/src/utils/git-ignored-paths.ts
@@ -0,0 +1,176 @@
+import { readFileSync, realpathSync, statSync } from "node:fs";
+import { isAbsolute, resolve } from "node:path";
+import { isSameOrDescendantPath } from "../server/path-utils.js";
+
+// Workspaces at or under these paths are plain directories to the daemon: it spawns no git (or
+// forge CLI) process there and sets up no git watchers. Agents' own git commands are untouched.
+export const GIT_IGNORED_PATHS_ENV = "PASEO_GIT_IGNORED_PATHS";
+const CONFIG_RELOAD_INTERVAL_MS = 5_000;
+const REALPATH_CACHE_MAX = 1_000;
+
+// What git itself prints outside a repository. Callers already treat this as "not a checkout".
+export const NOT_A_GIT_REPOSITORY_STDERR =
+  "fatal: not a git repository (or any of the parent directories): .git";
+
+export interface GitIgnoredPathsOptions {
+  env: NodeJS.ProcessEnv;
+  configPath?: string;
+  now?: () => number;
+}
+
+interface GitIgnoredPathsState {
+  env: NodeJS.ProcessEnv;
+  configPath: string | null;
+  now: () => number;
+  configMtimeMs: number | null;
+  lastCheckMs: number;
+  configuredPaths: string[];
+  roots: string[];
+  realpaths: Map<string, string | null>;
+}
+
+let state: GitIgnoredPathsState | null = null;
+
+export function parseGitIgnoredPathsEnv(value: string | undefined): string[] {
+  return (value ?? "").split(":").filter((entry) => entry.trim().length > 0);
+}
+
+export function resolveGitIgnoredPaths(input: {
+  env: NodeJS.ProcessEnv;
+  persisted?: readonly string[];
+}): string[] {
+  const merged = [
+    ...(input.persisted ?? []),
+    ...parseGitIgnoredPathsEnv(input.env[GIT_IGNORED_PATHS_ENV]),
+  ];
+  const paths: string[] = [];
+  for (const entry of merged) {
+    const trimmed = entry.trim();
+    if (!isAbsolute(trimmed)) {
+      continue;
+    }
+    const normalized = resolve(trimmed);
+    if (!paths.includes(normalized)) {
+      paths.push(normalized);
+    }
+  }
+  return paths;
+}
+
+export function configureGitIgnoredPaths(options: GitIgnoredPathsOptions): void {
+  const now = options.now ?? Date.now;
+  state = {
+    env: options.env,
+    configPath: options.configPath ?? null,
+    now,
+    configMtimeMs: null,
+    lastCheckMs: now(),
+    configuredPaths: [],
+    roots: [],
+    realpaths: new Map(),
+  };
+  loadConfiguredPaths(state);
+}
+
+export function resetGitIgnoredPaths(): void {
+  state = null;
+}
+
+export function getGitIgnoredPaths(): string[] {
+  if (!state) {
+    return [];
+  }
+  maybeReload(state);
+  return [...state.configuredPaths];
+}
+
+export function isGitIgnoredPath(cwd: string): boolean {
+  if (!state) {
+    return false;
+  }
+  maybeReload(state);
+  if (state.roots.length === 0) {
+    return false;
+  }
+  const lexical = resolve(cwd);
+  if (state.roots.some((root) => isSameOrDescendantPath(root, lexical))) {
+    return true;
+  }
+  const real = cachedRealpath(state, lexical);
+  return real !== null && state.roots.some((root) => isSameOrDescendantPath(root, real));
+}
+
+function maybeReload(current: GitIgnoredPathsState): void {
+  if (!current.configPath) {
+    return;
+  }
+  const nowMs = current.now();
+  if (nowMs - current.lastCheckMs < CONFIG_RELOAD_INTERVAL_MS) {
+    return;
+  }
+  current.lastCheckMs = nowMs;
+  if (readConfigMtime(current.configPath) !== current.configMtimeMs) {
+    loadConfiguredPaths(current);
+  }
+}
+
+function loadConfiguredPaths(current: GitIgnoredPathsState): void {
+  current.configMtimeMs = current.configPath ? readConfigMtime(current.configPath) : null;
+  const configuredPaths = resolveGitIgnoredPaths({
+    env: current.env,
+    persisted: current.configPath ? readPersistedIgnoredPaths(current.configPath) : [],
+  });
+  const roots = new Set(configuredPaths);
+  for (const path of configuredPaths) {
+    const real = tryRealpath(path);
+    if (real) {
+      roots.add(real);
+    }
+  }
+  current.configuredPaths = configuredPaths;
+  current.roots = [...roots];
+  current.realpaths.clear();
+}
+
+// Reads only daemon.git.ignoredPaths. A missing or unreadable file means no configured paths;
+// the daemon's own config loader reports a malformed file.
+function readPersistedIgnoredPaths(configPath: string): string[] {
+  try {
+    const parsed = JSON.parse(readFileSync(configPath, "utf8")) as {
+      daemon?: { git?: { ignoredPaths?: unknown } };
+    };
+    const paths = parsed.daemon?.git?.ignoredPaths;
+    return Array.isArray(paths) ? paths.filter((entry) => typeof entry === "string") : [];
+  } catch {
+    return [];
+  }
+}
+
+function readConfigMtime(configPath: string): number | null {
+  try {
+    return statSync(configPath).mtimeMs;
+  } catch {
+    return null;
+  }
+}
+
+function cachedRealpath(current: GitIgnoredPathsState, path: string): string | null {
+  const cached = current.realpaths.get(path);
+  if (cached !== undefined) {
+    return cached;
+  }
+  if (current.realpaths.size >= REALPATH_CACHE_MAX) {
+    current.realpaths.clear();
+  }
+  const real = tryRealpath(path);
+  current.realpaths.set(path, real);
+  return real;
+}
+
+function tryRealpath(path: string): string | null {
+  try {
+    return realpathSync(path);
+  } catch {
+    return null;
+  }
+}
