{
  "name": "paseo-slurm",
  "version": "0.4.0",
  "description": "Token-free Slurm completion watcher that resumes Paseo agents",
  "type": "module",
  "bin": {
    "paseo-slurm": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "patches",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run build && npm test",
    "apply-paseo-external-wait": "bash ./scripts/apply-paseo-external-wait.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
